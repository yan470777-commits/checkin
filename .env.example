# ============================================================
# NewAPI 自动签到 · 配置模板（不含任何真实凭证）
# 用法：把本文件复制为 .env（同目录），逐站替换 url 与 access_token
#
# 1) 令牌位置：站点 → 个人设置 / 令牌页 → 生成「系统访问令牌」，形如 nap_xxx（推荐）
# 2) 没令牌的站用账号密码：login_username + login_password（如 youkies、wanwanzhou）
# 3) NEWAPI_ACCOUNTS 必须是【一行】合法 JSON 数组，不能换行、不能写注释
# 4) 本文件配套的 .env 含凭证，切勿提交公开仓库或发给他人
# 5) 改完先跑：python status_report.py（只读，不会签到）
# ============================================================

NEWAPI_ACCOUNTS=[{"name":"站1-nemodesk","url":"https://站点1域名/","access_token":"nap_站点1令牌"},{"name":"站2-crouter","url":"https://站点2域名/","access_token":"nap_站点2令牌"},{"name":"站3-youkies","url":"https://站点3域名/","login_username":"你的账号","login_password":"你的密码"},{"name":"站4-xingya","url":"https://站点4域名/","access_token":"nap_站点4令牌"},{"name":"站5-catcat","url":"https://站点5域名/","access_token":"nap_站点5令牌"},{"name":"站6-limao","url":"https://站点6域名/","access_token":"nap_站点6令牌"},{"name":"站7-wanwanzhou","url":"https://站点7域名/","login_username":"你的账号","login_password":"你的密码","timeout":120},{"name":"站8-xincloud","url":"https://站点8域名/","access_token":"nap_站点8令牌"},{"name":"站9-htai91","url":"https://站点9域名/","access_token":"nap_站点9令牌"},{"name":"站10-kapibala","url":"https://站点10域名/","access_token":"nap_站点10令牌"},{"name":"站11-changchunxu","url":"https://站点11域名/","access_token":"nap_站点11令牌"}]

# ---- 可选：独立签到子站（主站签到走另一套服务的站，如 arityflow）----
# "checkin_url": "https://qd.站点域名"

# ---- 可选：手动签到站（登录被 Cloudflare 拦、只能浏览器手签的站）----
# 设为 true 后自动签到会跳过，且不计入失败数
# "disabled": true

# ---- 可选：user_id（个别站点部分接口需要，可加在对应对象里）----
# "user_id": "134",

# ---- 可选：固定签到码 / 在线抓取签到码（需要签到码的站点才填）----
# "checkin_code": "当天签到码"
# "checkin_code_url": "https://站点签到码发布页"
# "checkin_code_regex": "签到码[:：]\\s*(\\w+)"

# ---- 可选：通知（需要哪个就取消对应注释）----
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=SECxxxxxxxx
# SERVERCHAN_SENDKEY=SCTxxxxxxxx
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_USER=you@example.com
# EMAIL_SMTP_PASS=邮箱授权码
# EMAIL_SMTP_TO=receiver@example.com
# EMAIL_SMTP_FROM=you@example.com

# ---- 可选：云端同步配置（填了它，程序优先用云端，忽略上面的 NEWAPI_ACCOUNTS）----
# CONFIG_URL=https://dav.jianguoyun.com/dav/checkin/config.json
# CONFIG_AUTH=Basic xxxxxxxx
